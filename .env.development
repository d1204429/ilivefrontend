# 基礎環境配置
NODE_ENV=development
VITE_APP_NAME=iLive商城
VITE_APP_DESCRIPTION=提供優質商品與完善的購物體驗
VITE_APP_VERSION=1.0.0
VITE_SUPPORT_EMAIL=support@ilive.com
VITE_CONTACT_PHONE=0800-000-000

# API配置
VITE_API_BASE_URL=http://localhost:1988/api/v1
VITE_API_TIMEOUT=15000
VITE_API_MAX_RETRIES=3
VITE_API_RETRY_DELAY=1000
VITE_API_PREFIX=/api/v1

# API路徑配置
VITE_AUTH_API_PATH=/api/v1/users
VITE_PRODUCTS_API_PATH=/api/v1/products
VITE_CART_API_PATH=/api/v1/cart
VITE_ORDERS_API_PATH=/api/v1/orders
VITE_UPLOAD_API_PATH=/api/v1/upload
VITE_CATEGORIES_API_PATH=/api/v1/categories

# 開發伺服器配置
VITE_DEV_SERVER_PORT=8080
VITE_DEV_SERVER_HOST=localhost
VITE_DEV_SERVER_HTTPS=false
VITE_DEV_SERVER_PROXY_TARGET=http://localhost:1988
VITE_DEV_SERVER_PROXY_TIMEOUT=15000

# JWT與認證配置
VITE_JWT_TOKEN_KEY=iLive_token
VITE_JWT_REFRESH_KEY=iLive_refresh_token
VITE_JWT_TOKEN_EXPIRES=7200
VITE_JWT_REFRESH_EXPIRES=604800
VITE_JWT_TOKEN_PREFIX=Bearer
VITE_TOKEN_REFRESH_INTERVAL=900000
VITE_SESSION_TIMEOUT=3600000
VITE_TOKEN_STORAGE_PREFIX=iLive_token_

# 安全配置
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_LOCK_DURATION=1800000
VITE_PASSWORD_MIN_LENGTH=8
VITE_PASSWORD_MAX_LENGTH=20
VITE_PASSWORD_REQUIRE_UPPERCASE=true
VITE_PASSWORD_REQUIRE_LOWERCASE=true
VITE_PASSWORD_REQUIRE_NUMBER=true
VITE_PASSWORD_REQUIRE_SPECIAL=true
VITE_AUTH_HEADER=Authorization

# CORS配置
VITE_CORS_ENABLED=true
VITE_CORS_ORIGINS=http://localhost:8080,http://192.168.226.1:8080,http://192.168.180.1:8080,http://192.168.43.90:8080
VITE_CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
VITE_CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,Accept,Origin
VITE_CORS_EXPOSED_HEADERS=Content-Disposition,X-Total-Count
VITE_CORS_MAX_AGE=86400

# 存儲配置
VITE_STORAGE_PREFIX=iLive_
VITE_STORAGE_VERSION=1
VITE_CART_STORAGE_KEY=${VITE_STORAGE_PREFIX}cart
VITE_USER_STORAGE_KEY=${VITE_STORAGE_PREFIX}user
VITE_AUTH_STORAGE_KEY=${VITE_STORAGE_PREFIX}auth
VITE_CACHE_PREFIX=${VITE_STORAGE_PREFIX}cache_
VITE_CACHE_TTL=3600

# 購物車配置
VITE_MIN_ORDER_AMOUNT=100
VITE_FREE_SHIPPING_AMOUNT=1000
VITE_MAX_CART_ITEMS=50
VITE_MIN_PURCHASE_QUANTITY=1
VITE_MAX_PURCHASE_QUANTITY=99
VITE_CART_EXPIRE_DAYS=7

# 錯誤處理配置
VITE_ERROR_SHOW_DURATION=3000
VITE_ERROR_LOG_LEVEL=error
VITE_ERROR_REPORT_URL=/api/v1/error-logs
VITE_ERROR_RETRY_COUNT=3
VITE_ERROR_RETRY_DELAY=1000

# 請求配置
VITE_REQUEST_TIMEOUT=15000
VITE_REQUEST_RETRY_COUNT=3
VITE_REQUEST_RETRY_DELAY=1000
VITE_REQUEST_CACHE_TIME=300000
VITE_REQUEST_MAX_REDIRECTS=5

# 分頁配置
VITE_DEFAULT_PAGE_SIZE=10
VITE_MAX_PAGE_SIZE=50
VITE_PAGE_SIZE_OPTIONS=[10,20,30,50]
VITE_DEFAULT_PAGE_NUMBER=1

# 上傳配置
VITE_UPLOAD_MAX_SIZE=5242880
VITE_UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif
VITE_UPLOAD_PATH=/uploads
VITE_UPLOAD_MAX_FILES=5
VITE_UPLOAD_CHUNK_SIZE=2097152

# 日誌配置
VITE_LOG_LEVEL=debug
VITE_LOG_OUTPUT=console
VITE_LOG_PREFIX=[iLive]
VITE_LOG_DATE_FORMAT=YYYY-MM-DD HH:mm:ss
VITE_LOG_FILE_PATH=logs/
VITE_LOG_MAX_FILES=10

# WebSocket配置
VITE_WS_ENABLED=true
VITE_WS_URL=ws://localhost:1988/ws
VITE_WS_RECONNECT=true
VITE_WS_RECONNECT_ATTEMPTS=5
VITE_WS_RECONNECT_DELAY=3000
VITE_WS_HEARTBEAT_INTERVAL=30000
VITE_WS_PING_TIMEOUT=5000

# 效能配置
VITE_ENABLE_COMPRESSION=true
VITE_ENABLE_CACHE=true
VITE_CACHE_DURATION=3600
VITE_ENABLE_LAZY_LOAD=true
VITE_CHUNK_SIZE_WARNING=2000
VITE_ENABLE_MINIFICATION=true

# 開發工具配置
VITE_ENABLE_DEVTOOLS=true
VITE_SOURCE_MAPS=true
VITE_HOT_RELOAD=true
VITE_ENABLE_MOCK=true
VITE_ENABLE_VCONSOLE=true
VITE_ENABLE_LOGGER=true

# 多語系配置
VITE_DEFAULT_LOCALE=zh-TW
VITE_AVAILABLE_LOCALES=zh-TW,en-US
VITE_FALLBACK_LOCALE=en-US
VITE_LOCALE_STORAGE_KEY=${VITE_STORAGE_PREFIX}locale
VITE_LOCALE_CACHE_TTL=86400
